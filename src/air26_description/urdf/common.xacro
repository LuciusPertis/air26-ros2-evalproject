<?xml version="1.0"?>
<!--
  common.xacro — shared materials and inertial-macro helpers.
  Nothing robot-specific lives here; it is included by air26_robot.urdf.xacro.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================ materials ============================ -->
  <material name="a26_body">   <color rgba="0.20 0.22 0.25 1.0"/> </material>
  <material name="a26_accent"> <color rgba="0.90 0.55 0.10 1.0"/> </material>
  <material name="a26_wheel">  <color rgba="0.08 0.08 0.08 1.0"/> </material>
  <material name="a26_sensor"> <color rgba="0.10 0.60 0.85 1.0"/> </material>
  <material name="a26_lidar">  <color rgba="0.80 0.10 0.10 1.0"/> </material>
  <material name="a26_paddle"> <color rgba="0.85 0.85 0.88 1.0"/> </material>

  <!-- ======================= inertial helpers ========================= -->
  <!-- Solid box inertia about its center of mass. -->
  <xacro:macro name="box_inertial" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass/12.0 * (y*y + z*z)}" ixy="0.0" ixz="0.0"
        iyy="${mass/12.0 * (x*x + z*z)}" iyz="0.0"
        izz="${mass/12.0 * (x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <!-- Solid cylinder inertia, symmetry axis along local Z. -->
  <xacro:macro name="cylinder_inertial" params="mass radius length *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass/12.0 * (3*radius*radius + length*length)}" ixy="0.0" ixz="0.0"
        iyy="${mass/12.0 * (3*radius*radius + length*length)}" iyz="0.0"
        izz="${mass/2.0 * radius*radius}"/>
    </inertial>
  </xacro:macro>

</robot>
