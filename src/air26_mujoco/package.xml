<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>air26_mujoco</name>
  <version>0.1.0</version>
  <description>
    MuJoCo physics engine for the AIR26 rover (M1 reference): MJCF world + light
    obstacles and a driver that speaks the shared ROS interface. Engine-specific;
    lives only on the mujoco branch.
  </description>
  <maintainer email="air26@example.com">AIR26 Workshop</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>air26_bringup</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- the `mujoco` python package is a pip dependency (>=3.0); not in rosdep -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
